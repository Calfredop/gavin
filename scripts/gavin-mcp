#!/bin/sh
# Resolve and exec the gavin-mcp binary for whatever machine this
# checkout is sitting on.
#
# `.mcp.json` and `.cursor/mcp.json` are COMMITTED and the same checkout is
# opened from a Mac and a Windows box, so neither file can name an absolute
# path: whichever machine last ran the wizard's integration step re-pointed
# it and broke the other. The file flip-flopped three times on that account
# (d4191db, 030d99f, b8ba17c) and ended up naming a binary that existed on
# NEITHER machine, which costs every agent session all sixteen gavin_* tools.
# So the configs name this script by RELATIVE path and the resolving happens
# here, once, at launch.
#
# Windows runs `gavin-mcp.cmd` beside this file: the configs say
# `scripts/gavin-mcp` on both platforms and Windows resolves that through
# PATHEXT to the .cmd. The two scripts must keep the same search order.
#
# Nothing may reach stdout but the binary's own JSON-RPC -- a stray echo
# corrupts the stream and the server dies as a parse error. Diagnostics go
# to stderr.

set -eu

# Resolved from this script's own directory, never the caller's cwd, so a
# worktree finds ITS target/ and the answer does not change with wherever
# the agent happened to be started.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$here")

# Cursor strips the PTY env from MCP children, including GAVIN_MCP. The
# daemon wrote the pin under mcp-env/<ancestor-pid> (`protocol::mcp_env`);
# recover it here so the candidate list still prefers that build. The
# binary then recovers the rest of the session env the same way.
if [ -z "${GAVIN_MCP:-}" ]; then
    pid=${PPID:-}
    i=0
    while [ "$i" -lt 8 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
        for d in \
            "$HOME/Library/Application Support/gavin/mcp-env" \
            "$HOME/Library/Application Support/gavin/mcp-env-dev" \
            "${XDG_DATA_HOME:-$HOME/.local/share}/gavin/mcp-env" \
            "${XDG_DATA_HOME:-$HOME/.local/share}/gavin/mcp-env-dev" \
            "${LOCALAPPDATA:-}/gavin/mcp-env" \
            "${LOCALAPPDATA:-}/gavin/mcp-env-dev"
        do
            [ -n "$d" ] || continue
            f="$d/$pid"
            if [ -f "$f" ]; then
                while IFS= read -r line || [ -n "$line" ]; do
                    case "$line" in
                        GAVIN_MCP=*)
                            GAVIN_MCP=${line#GAVIN_MCP=}
                            export GAVIN_MCP
                            break 3
                            ;;
                    esac
                done < "$f"
            fi
        done
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' \t') || break
        i=$((i + 1))
    done
fi

# Order matters. GAVIN_MCP is normally set by the daemon that opened this
# tab (`PtySession::spawn`): the gavin-mcp beside that daemon, so a
# freshly-cut worktree with no target/ still runs the same build that
# launched the agent, with no version skew against an installed release.
# A dev iterating on gavin-mcp in a worktree must set GAVIN_MCP to their
# build explicitly — the daemon's pin wins over this checkout's target/.
# Without GAVIN_MCP the installed app leads (it exists on both machines
# and in every worktree), then this checkout's target/, then PATH.
candidates=$(cat <<EOF
${GAVIN_MCP:-}
$HOME/Applications/Gavin.app/Contents/MacOS/gavin-mcp
/Applications/Gavin.app/Contents/MacOS/gavin-mcp
$root/target/release/gavin-mcp
$root/target/debug/gavin-mcp
EOF
)

# A plain `while ... done < heredoc` keeps the loop in this shell -- piping
# into it would set `found` in a subshell and lose it.
found=""
while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    if [ -x "$candidate" ]; then
        found=$candidate
        break
    fi
done <<EOF
$candidates
EOF

if [ -z "$found" ] && command -v gavin-mcp >/dev/null 2>&1; then
    found=$(command -v gavin-mcp)
fi

if [ -z "$found" ]; then
    # Name every path tried. The failure an agent otherwise sees is a bare
    # `gavin (CONNECTION_CLOSED)`, which says nothing about what was wrong.
    echo "gavin-mcp: no binary found. Tried, in order:" >&2
    echo "$candidates" | while IFS= read -r candidate; do
        [ -n "$candidate" ] && echo "  $candidate" >&2
    done
    echo "  gavin-mcp on PATH" >&2
    echo "Install Gavin, run \`cargo build -p gavin-mcp\`, or set GAVIN_MCP." >&2
    exit 1
fi

exec "$found" "$@"

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App target's own privacy manifest. App Store Connect refuses an
     upload whose code reads a required-reason API that no manifest
     declares (ITMS-91053); Capacitor's package declares its own.
     UserDefaults (CA92.1): the plugins keep the installed marker, and read
     launch-argument flags, for this app alone.
     Nothing is collected: what the app sends goes to the user's own
     Workstation, through a Relay that carries it end-to-end encrypted. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

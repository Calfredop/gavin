{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gavin",
  "version": "0.1.0",
  "identifier": "com.gavin.app",
  "build": {
    "beforeDevCommand": "cargo build -p gavin-daemon -p gavin-mcp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build --release -p gavin-daemon -p gavin-mcp && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Gavin",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

# Scratch config used for the audit run only; NOT part of the repo.
[advisories]
version = 2
[licenses]
version = 2
allow = ["MIT","Apache-2.0","BSD-2-Clause","BSD-3-Clause","ISC","Zlib","Unicode-3.0","MPL-2.0","CC0-1.0","BSL-1.0","OpenSSL","Unlicense","0BSD","MIT-0","Apache-2.0 WITH LLVM-exception","CDLA-Permissive-2.0"]
[bans]
multiple-versions = "warn"
wildcards = "warn"
[sources]
unknown-registry = "deny"
unknown-git = "deny"
